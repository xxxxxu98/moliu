      "plotOutline": [
        {
          "id": "plot-1790343167020-0",
          "title": "第一幕",
          "description": "沈淮破局通州仓假账脱罪，借助隆安帝清查户部亏空的契机，整顿京仓并追讨皇庄欠款，在户部站稳脚跟升迁；沈淮在三司会审大殿当众用复式记账法还原十二年暗账，直接牵出大皇子私设的小金库，隆安帝将沈淮拔擢为户部员外郎专办清欠",
          "type": "act",
          "orderIndex": 0
        },
        {
          "id": "plot-1790343167020-1",
          "title": "第二幕上",
          "description": "沈淮主导推行全国预决算制与两淮盐税改革，打破地方截留，从江南门阀手中夺回朝廷盐铁财权；沈淮亲赴江南查办盐运司，遭遇黑金势力纵火烧毁总账，沈淮以“下游盐引推演上游产量”的反向审计法锁定私盐铁证，瓦解三皇子与江南士族的结盟",
          "type": "act",
          "orderIndex": 1
        },
        {
          "id": "plot-1790343167020-2",
          "title": "第二幕下",
          "description": "沈淮筹建大靖皇家银号，发行官银宝券，收回天下铸币权以平抑西北边患与财政危机；隆安帝突发中风昏迷，大皇子勾结户部旧党与西北藩王，伪造宝券挤兑户部银库，发动兵变封锁京师，沈淮被围困于银号之内命悬一线",
          "type": "act",
          "orderIndex": 2
        },
        {
          "id": "plot-1790343167020-3",
          "title": "第三幕",
          "description": "彻底粉碎大皇子政变，全面收拢帝国财政主权，辅佐新君登基，建立跨时代的国家财税制度；沈淮进位文华殿大学士兼户部尚书，新朝确立现代预决算与银号管理法，帝国财政充盈盛世开启，沈淮执掌帝国经济命脉，群臣俯首",
          "type": "act",
          "orderIndex": 3
        },
        {
          "id": "plot-1790343167020-4",
          "title": "京畿皇庄追缴与勋贵钱袋清算",
          "description": "承接通州仓大案外溢效应，为主角从自保算吏晋升为朝廷清欠快刀提供合法职权，同时暴露大皇子与旧勋贵隐匿军饷的深层网络；主线通州仓案的直接延伸，沈淮借助查账撕开皇庄隐匿私产的豁口，斩断大皇子在京畿的现金流，促使皇帝彻底倒向支持财税改制",
